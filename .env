# =============================================================================
# .env.example  —  project root
# =============================================================================
# Copy this file to .env and fill in real values:
#
#   cp .env.example .env
#
# This single file is used by BOTH:
#   • Docker Compose (variable substitution for the postgres service)
#   • The backend container (injected as os.environ via env_file: ./.env)
#
# NEVER commit .env to git. The .env.example (with placeholder values) is
# safe to commit and shows teammates what variables are needed.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# DB_HOST is overridden to "postgres" inside docker-compose.yml automatically.
# The value here (localhost) is only used when running the app outside Docker.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=proxmox_app
DB_USER=postgres

# IMPORTANT: set this to the same value in BOTH this file and nowhere else.
# Docker Compose reads DB_PASSWORD from here to initialise Postgres AND
# to tell the backend what password to connect with.
DB_PASSWORD=postgres

DB_SSLMODE=prefer
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate a strong secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Proxmox ───────────────────────────────────────────────────────────────────
PROXMOX_HOST=192.168.31.192
PROXMOX_USER=root@pam
PROXMOX_PASSWORD=verventech123
PROXMOX_NODE=azam
PROXMOX_VERIFY_SSL=false
