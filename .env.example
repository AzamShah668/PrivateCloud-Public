# =============================================================================
# .env.example  —  project root  (BOOTSTRAP ONLY)
# =============================================================================
# Copy this file to .env and fill in real values:
#
#   cp .env.example .env
#
# ── What lives where (Iteration 6) ──────────────────────────────────────────
# As of the first-run Setup Wizard, OPERATIONAL config (Proxmox connector, LLM
# provider, VM credentials, Guacamole admin login) is configured IN THE APP and
# stored in the database (secrets encrypted at rest). You do NOT need to put it
# here anymore — log in as the first user (auto-admin) and the Setup Wizard
# will prompt for it. You can edit it later in Admin → Settings.
#
# This file now only needs the BOOTSTRAP values that must exist before the app
# can reach its own database (a setting can't live inside the DB it unlocks):
#   • Database connection      • Redis broker
#   • JWT secret               • SETTINGS_ENCRYPTION_KEY (encrypts DB secrets)
#   • Guacamole MySQL / internal infra (consumed by docker-compose itself)
#
# NEVER commit .env to git. Only this .env.example (with placeholders) is safe.
# =============================================================================

# ── Database (REQUIRED — bootstrap) ──────────────────────────────────────────
# DB_HOST is overridden to "postgres" inside docker-compose.yml automatically.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=proxmox_app
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_SSLMODE=prefer
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── JWT Authentication (REQUIRED — bootstrap) ────────────────────────────────
# Generate a strong secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Settings encryption key (REQUIRED — bootstrap) ───────────────────────────
# Fernet key used to encrypt secret settings (Proxmox/LLM/Guacamole passwords)
# at rest in the database. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# (or, without cryptography installed:)
#   python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# WARNING: changing this after secrets are saved makes them undecryptable.
SETTINGS_ENCRYPTION_KEY=CHANGE_ME_generate_a_fernet_key

# ── Guacamole infra (REQUIRED — consumed by docker-compose) ──────────────────
# The Guacamole MySQL passwords are needed by docker-compose to provision the
# mysql-guacamole service. The Guacamole ADMIN login moved to the Setup Wizard
# (guacamole.admin_user / guacamole.admin_password) but can be pre-seeded below.
GUACAMOLE_MYSQL_ROOT_PASSWORD=guacroot
GUACAMOLE_MYSQL_PASSWORD=guacamole

# =============================================================================
# OPTIONAL FALLBACK — normally configured in the Setup Wizard, NOT here.
# Uncomment a value only if you want to pre-seed it via env instead of the UI.
# Anything left unset/blank here is expected to be entered in the wizard.
# =============================================================================

# ── Proxmox connector (set in the Setup Wizard) ──────────────────────────────
# PROXMOX_HOST=192.168.x.x
# PROXMOX_NODE=pve
# PROXMOX_VERIFY_SSL=false
# PROXMOX_TOKEN_ID=root@pam!mytoken
# PROXMOX_TOKEN_SECRET=your-token-uuid-here
# PROXMOX_USER=root@pam
# PROXMOX_PASSWORD=your_proxmox_password_here
# GOLDEN_IMAGE_VMID=9000
# WINDOWS_TEMPLATE_VMID=9001

# ── VM guest credentials (set in the Setup Wizard) ───────────────────────────
# VM_DEFAULT_USERNAME=ubuntu
# VM_DEFAULT_PASSWORD=your_golden_image_password_here
# VM_WINDOWS_USERNAME=windows
# VM_WINDOWS_PASSWORD=your_windows_golden_password_here

# ── AI ChatOps / LLM provider (set in the Setup Wizard) ──────────────────────
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-4o-mini

# ── Guacamole admin login (set in the Setup Wizard) ──────────────────────────
# GUACAMOLE_ADMIN_USER=guacadmin
# GUACAMOLE_ADMIN_PASSWORD=guacadmin
# GUACAMOLE_PUBLIC_URL=http://localhost:9080/guacamole
