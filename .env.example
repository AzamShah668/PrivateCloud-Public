# =============================================================================
# .env.example  —  project root
# =============================================================================
# Copy this file to .env and fill in real values:
#
#   cp .env.example .env
#
# This single file is used by BOTH:
#   - Docker Compose (variable substitution for the postgres service)
#   - The backend container (injected as os.environ via env_file: ./.env)
#
# NEVER commit .env to git. Only this .env.example (with placeholders) is safe.
# =============================================================================

# -- Database ------------------------------------------------------------------
# DB_HOST is overridden to "postgres" inside docker-compose.yml automatically.
# The value here (localhost) is only used when running the app outside Docker.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=proxmox_app
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_SSLMODE=prefer
DB_POOL_MIN=2
DB_POOL_MAX=10

# -- JWT Authentication --------------------------------------------------------
# Generate a strong secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# -- Proxmox -------------------------------------------------------------------
#PROXMOX_HOST=wrecking-purr-rumbling.ngrok-free.dev
PROXMOX_HOST=192.168.x.x
PROXMOX_NODE=pve
PROXMOX_VERIFY_SSL=false

# Option 1: API Token auth (preferred — tokens never expire)
# Create a token in Proxmox: Datacenter → Permissions → API Tokens
# Format: user@realm!tokenname  (e.g. root@pam!mytoken)
PROXMOX_TOKEN_ID=root@pam!mytoken
PROXMOX_TOKEN_SECRET=your-token-uuid-here

# Option 2: Legacy ticket auth (used if PROXMOX_TOKEN_ID is not set)
# PROXMOX_USER=root@pam
# PROXMOX_PASSWORD=your_proxmox_password_here

# -- Golden Image (VM Template) ------------------------------------------------
# VMID of the Proxmox template to clone new VMs from.
# Create the template in Proxmox first, then set its VMID here.
GOLDEN_IMAGE_VMID=9000

# Windows 11 Proxmox template VMID (clone source when os_choice is windows-11)
WINDOWS_TEMPLATE_VMID=9001

# Default SSH credentials baked into the golden image.
# These are returned to the user after VM creation so they know how to log in.
# Set these to match whatever user/password you configured in the golden image.
VM_DEFAULT_USERNAME=ubuntu
VM_DEFAULT_PASSWORD=your_golden_image_password_here

# Optional: logins baked into the Windows template (defaults to VM_DEFAULT_* if omitted)
# VM_WINDOWS_USERNAME=windows
# VM_WINDOWS_PASSWORD=your_windows_golden_password_here

# -- AI ChatOps (OpenAI) --------------------------------------------------------
# Required for POST /ai/chat when running the backend with ChatOps enabled.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# -- Apache Guacamole (in-browser RDP for Windows VMs) -------------------------
# When running the backend outside Docker but Guacamole in Docker:
#   GUACAMOLE_API_URL=http://127.0.0.1:9080/guacamole
#   GUACAMOLE_PUBLIC_URL=http://localhost:9080/guacamole
# Docker Compose overrides these for the backend container automatically.
# GUACAMOLE_API_URL=
# GUACAMOLE_PUBLIC_URL=
GUACAMOLE_ADMIN_USER=guacadmin
GUACAMOLE_ADMIN_PASSWORD=guacadmin
# MySQL (Guacamole metadata) — used by docker-compose for mysql-guacamole
GUACAMOLE_MYSQL_ROOT_PASSWORD=guacroot
GUACAMOLE_MYSQL_PASSWORD=guacamole
# GUACAMOLE_TLS_VERIFY=false
