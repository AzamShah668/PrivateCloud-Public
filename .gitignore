# =============================================================================
# .gitignore — PrivateCloud
# =============================================================================

# ── Secrets / Environment ────────────────────────────────────────────────────
# NEVER commit real credentials. Only .env.example (with placeholders) is safe.
.env
**/.env

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/

# ── Virtual environments (OS-specific binaries — never commit) ───────────────
venv/
.venv/
env/
**/venv/
**/.venv/

# ── Node / Frontend ─────────────────────────────────────────────────────────
node_modules/
**/node_modules/
frontend/dist/

# ── Docker ───────────────────────────────────────────────────────────────────
# Docker volumes / data directories created at runtime
postgres_data/

# ── Testing ──────────────────────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
.coverage.*

# ── IDE / Editor ─────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── Claude Code (local-only, invisible on GitHub) ───────────────────────────
CLAUDE.md
.claude/

# ── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
# Raw media sources (large, local-only; processed versions live in frontend/public/)
assets-raw/

# ── Graphify / Wiki-Brain (Local Knowledge Base) ────────────────────────────
# These contain the knowledge graph and Obsidian vault
graphify-out/
.graphify*
_gen_obsidian.py

# ── Distilled knowledge base (Brain 2) — TRACKED ────────────────────────────
# Committed to git so teammates and future sessions get the project's distilled
# decisions/infra/debugging context. Verified clean of secrets — NEVER paste
# real credentials, tokens, or keys into these files (they're published).
# docs/knowledge/
# …but keep Obsidian app metadata and empty scratch files out of git.
docs/knowledge/.obsidian/
docs/knowledge/*.base
docs/knowledge/*.canvas
docs/knowledge/2[0-9][0-9][0-9]-*.md

# ── One-off debug/patch scripts (throwaway, not project code) ───────────────
fix_guac.js
patch_guac.py

