# =============================================================================
# .gitignore — PrivateCloud
# =============================================================================

# ── Secrets / Environment ────────────────────────────────────────────────────
# NEVER commit real credentials. Only .env.example (with placeholders) is safe.
.env
**/.env

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/

# ── Virtual environments (OS-specific binaries — never commit) ───────────────
venv/
.venv/
env/
**/venv/
**/.venv/

# ── Node / Frontend ─────────────────────────────────────────────────────────
node_modules/
**/node_modules/
frontend/dist/

# ── Docker ───────────────────────────────────────────────────────────────────
# Docker volumes / data directories created at runtime
postgres_data/

# ── Testing ──────────────────────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
.coverage.*

# ── IDE / Editor ─────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── Claude Code (local-only, invisible on GitHub) ───────────────────────────
CLAUDE.md
.claude/

# ── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*vecteezy*.mov
*vecteezy*.mp4

# ── Local debug / repair scripts (Windows host troubleshooting) ─────────────
extract_log.ps1
list_drives.ps1
repair_*.ps1
repair_log*.txt
status.txt
status_check.ps1
