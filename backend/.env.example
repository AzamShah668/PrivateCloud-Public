# =============================================================================
# .env.example — copy this to .env and fill in real values
# =============================================================================
# NEVER commit .env to git. Add it to .gitignore.
# This .env.example (with placeholder values) IS safe to commit.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=proxmox_app
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_SSLMODE=prefer
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate a secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Proxmox ───────────────────────────────────────────────────────────────────
PROXMOX_HOST=192.168.1.100       # IP or hostname of your Proxmox server
PROXMOX_USER=root@pam            # Proxmox login (realm: @pam or @pve)
PROXMOX_PASSWORD=your_proxmox_password_here
PROXMOX_NODE=pve                 # Default node name (check Proxmox web UI)
PROXMOX_VERIFY_SSL=false         # Set to true if using a valid SSL cert
