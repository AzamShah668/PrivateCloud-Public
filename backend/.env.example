# =============================================================================
# .env.example — copy this to .env and fill in real values
# =============================================================================
# NEVER commit .env to git. Add it to .gitignore.
# This .env.example (with placeholder values) IS safe to commit.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=proxmox_app
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_SSLMODE=prefer
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate a secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Proxmox ───────────────────────────────────────────────────────────────────
PROXMOX_HOST=192.168.1.100       # IP or hostname of your Proxmox server
PROXMOX_USER=root@pam            # Proxmox login (realm: @pam or @pve)
PROXMOX_PASSWORD=your_proxmox_password_here
PROXMOX_NODE=home                # Default node name (check Proxmox web UI)
PROXMOX_VERIFY_SSL=false         # Set to true if using a valid SSL cert

# ── VM templates (clone provisioning) ───────────────────────────────────────
# Linux cloud-init template (ubuntu / debian / centos OS choices)
GOLDEN_IMAGE_VMID=9000
# Windows 11 template — used only when os_choice is windows-11
WINDOWS_TEMPLATE_VMID=9001
# Login hints returned on the job after create (match your golden images)
VM_DEFAULT_USERNAME=ubuntu
VM_DEFAULT_PASSWORD=your_linux_golden_password_here
# Optional — if unset, Windows jobs reuse VM_DEFAULT_* (set for mixed Linux+Windows)
# VM_WINDOWS_USERNAME=windows
# VM_WINDOWS_PASSWORD=your_windows_template_password_here

# ── AI ChatOps (OpenAI) ───────────────────────────────────────────────────────
# Required for POST /ai/chat. Get a key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: defaults to gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini
# Optional: compatible API base URL (Azure, proxies, etc.)
# OPENAI_BASE_URL=

# ── Apache Guacamole (optional — POST /vms/{id}/desktop-session) ─────────────
# GUACAMOLE_API_URL=http://127.0.0.1:9080/guacamole
# GUACAMOLE_PUBLIC_URL=http://localhost:9080/guacamole
# GUACAMOLE_ADMIN_USER=guacadmin
# GUACAMOLE_ADMIN_PASSWORD=guacadmin
